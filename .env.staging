# Staging — separate React app → Laravel API at staging.myvagon.com

# Shipper panel API (Sanctum bearer auth)
VITE_API_BASE_URL=https://staging.myvagon.com/api/shipper/v1

# Laravel backend (Vite dev proxy when running locally against staging API)
VITE_LARAVEL_URL=https://staging.myvagon.com

# React router base path (standalone deployment)
VITE_BASE_PATH=/

# Legacy axios client base (loginAPI, forgotPasswordAPI, etc.)
VITE_API_URL=https://staging.myvagon.com/api/
VITE_API_VERSION=

# Google Maps (Places autocomplete + detail map embed)
VITE_GOOGLE_MAPS_KEY=
