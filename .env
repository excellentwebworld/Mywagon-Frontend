# Copy to .env for local overrides, or use mode-specific files:
#   .env.development  — local dev (npm run dev)
#   .env.staging        — staging build (npm run build:staging)
#   .env.production     — production build (npm run build)

# Shipper panel API (Sanctum bearer auth)
# Local:  /api/shipper/v1  (proxied via Vite to VITE_LARAVEL_URL)
# Staging: https://staging.myvagon.com/api/shipper/v1
VITE_API_BASE_URL=https://staging.myvagon.com/api/shipper/v1

# Laravel backend URL (Vite dev proxy target only)
VITE_LARAVEL_URL=https://staging.myvagon.com

# React router base path
VITE_BASE_PATH=/

# Legacy axios client (optional — loginAPI / forgotPasswordAPI)
VITE_API_URL=https://staging.myvagon.com/api/shipper/
VITE_API_VERSION=v1
